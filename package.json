{
  "name": "probe",
  "version": "1.0.0",
  "description": "Probe is a web GUI application with for Hyperledger Fabric mantianer, user, research to find the best block config logic for my chaincode.",
  "main": "app.js",
  "scripts": {
    "start": "node ./bin/www",
    "lint": "eslint --ext .js ./lib ./routes ./test ./e2e",
    "test": "export NODE_ENV=test PORT=3300 && nyc mocha 'test/**/*.test.js' --timeout 5000 --exit",
    "cover:report": "nyc report --reporter=lcov --reporter=text",
    "e2eTestNetwork": "export NODE_ENV=test PORT=3000 && mocha 'e2e/testnetwork.test.js' --timeout 600000 --exit",
    "e2eMiniFab": "export NODE_ENV=test PORT=3000 && mocha 'e2e/minifab.test.js' --timeout 600000 --exit",
    "build": "webpack"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SamYuan1990/Probe.git"
  },
  "keywords": [
    "preformance",
    "fabric"
  ],
  "author": "SamYuan1990",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/SamYuan1990/Probe/issues"
  },
  "homepage": "https://github.com/SamYuan1990/Probe#readme",
  "dependencies": {
    "body-parser": "^2.3.0",
    "cookie-parser": "^1.4.7",
    "csv": "^5.5.3",
    "debug": "~4.4.0",
    "ejs": "^7.0.1",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "express-slow-down": "^3.1.1",
    "helmet": "^8.3.0",
    "http-errors": "~2.0.0",
    "i18next-browser-languagedetector": "^8.2.1",
    "i18next-http-backend": "^4.0.3",
    "log4js": "^6.9.1",
    "morgan": "~1.12.1",
    "pug": "^3.0.4",
    "react-i18next": "^17.0.18",
    "react-json-view": "^1.21.3",
    "system-sleep": "^1.3.8"
  },
  "devDependencies": {
    "@babel/core": "^8.0.7",
    "@babel/preset-env": "^8.0.7",
    "@babel/preset-react": "^8.0.1",
    "babel-loader": "^10.1.1",
    "bootstrap": "^5.3.8",
    "chai": "^4.3.6",
    "eslint": "^10.12.0",
    "i18next": "^26.4.6",
    "jquery": "^4.0.0",
    "mocha": "^12.0.3",
    "nyc": "^18.0.0",
    "react": "^19.3.1",
    "react-bootstrap": "^2.10.10",
    "react-dom": "^19.3.1",
    "react-redux": "^9.3.0",
    "react-router-dom": "^7.18.4",
    "react-transition-group": "^4.4.2",
    "redux": "^5.0.1",
    "redux-devtools": "^3.7.0",
    "redux-undo": "^1.1.0",
    "supertest": "^7.3.1",
    "webpack": "^5.112.0",
    "webpack-cli": "^7.2.3"
  }
}
